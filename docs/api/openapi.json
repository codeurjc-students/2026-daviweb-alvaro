{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful\n\nMongoDB is not reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/services": {
      "get": {
        "operationId": "ServicesController_findPage",
        "parameters": [
          {
            "name": "x-tenant-id",
            "in": "header",
            "description": "Tenant (hairdresser) the request belongs to",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServicePageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or missing tenant"
          }
        },
        "summary": "List the services of the tenant, paginated",
        "tags": [
          "services"
        ]
      },
      "post": {
        "operationId": "ServicesController_create",
        "parameters": [
          {
            "name": "x-tenant-id",
            "in": "header",
            "description": "Tenant (hairdresser) the request belongs to",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateServiceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "URL of the new service",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or missing tenant"
          }
        },
        "summary": "Create a service",
        "tags": [
          "services"
        ]
      }
    },
    "/api/v1/services/{id}": {
      "get": {
        "operationId": "ServicesController_findById",
        "parameters": [
          {
            "name": "x-tenant-id",
            "in": "header",
            "description": "Tenant (hairdresser) the request belongs to",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters or missing tenant"
          },
          "404": {
            "description": "Service not found for this tenant"
          }
        },
        "summary": "Get a service by id",
        "tags": [
          "services"
        ]
      }
    }
  },
  "info": {
    "title": "Daviweb API",
    "description": "REST API of the multi-tenant hairdresser booking platform",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "TimeSegmentDto": {
        "type": "object",
        "properties": {
          "duration": {
            "type": "number",
            "minimum": 1
          },
          "breakAfter": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "duration"
        ]
      },
      "HairLengthModifierDto": {
        "type": "object",
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeSegmentDto"
            }
          }
        },
        "required": [
          "time"
        ]
      },
      "HairLengthModifiersDto": {
        "type": "object",
        "properties": {
          "short": {
            "$ref": "#/components/schemas/HairLengthModifierDto"
          },
          "medium": {
            "$ref": "#/components/schemas/HairLengthModifierDto"
          },
          "long": {
            "$ref": "#/components/schemas/HairLengthModifierDto"
          }
        },
        "required": [
          "short",
          "medium",
          "long"
        ]
      },
      "HourRangeDto": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "ServiceResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "timeSegments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeSegmentDto"
            }
          },
          "requiresHairLength": {
            "type": "boolean"
          },
          "hairLengthModifiers": {
            "$ref": "#/components/schemas/HairLengthModifiersDto"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "hourRange": {
            "$ref": "#/components/schemas/HourRangeDto"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "timeSegments",
          "requiresHairLength"
        ]
      },
      "ServicePageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceResponseDto"
            }
          },
          "page": {
            "type": "number"
          },
          "size": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total",
          "hasMore"
        ]
      },
      "CreateServiceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "timeSegments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeSegmentDto"
            }
          },
          "requiresHairLength": {
            "type": "boolean"
          },
          "hairLengthModifiers": {
            "$ref": "#/components/schemas/HairLengthModifiersDto"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "hourRange": {
            "$ref": "#/components/schemas/HourRangeDto"
          }
        },
        "required": [
          "name",
          "description",
          "timeSegments",
          "requiresHairLength"
        ]
      }
    }
  }
}
